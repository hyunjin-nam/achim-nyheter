{
  "expo": {
    "name": "Achim Nyheter",
    "slug": "achim-nyheter",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "achimnyheter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jinanam.achimnyheter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD60A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#111113"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "WordWidget",
              "displayName": "Word of the moment",
              "description": "A new word from your news every 30 minutes.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/word-widget.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "521cc21b-7883-4a81-b48d-2c09579c8514"
      }
    },
    "owner": "jakob-and-hyunjin",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/521cc21b-7883-4a81-b48d-2c09579c8514"
    }
  }
}
